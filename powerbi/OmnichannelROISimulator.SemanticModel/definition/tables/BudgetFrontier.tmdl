	partition BudgetFrontier = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "BudgetFrontier.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Budget", type number}, {"OptimalIncrementalSales", type number}, {"CurrentMixIncrementalSales", type number}, {"OptimalROI", type number}, {"CurrentMixROI", type number}, {"MarginalROI", type number}}, "en-US")
				in
